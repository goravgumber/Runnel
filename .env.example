# ==============================================================================
# Runnel Environment Configuration Contract (.env.example)
# Open-source recovery inbox for asynchronous work.
# Copy this file to .env (or backend/.env) and configure appropriate values.
# ==============================================================================

# Runtime environment (development | production | test)
NODE_ENV=development

# HTTP Service Port
PORT=5000

# MongoDB Connection URI
MONGO_URI=mongodb://127.0.0.1:27017/runnel

# Redis Connection URI (used for BullMQ queues, refresh-token tracking, and cache)
REDIS_URL=redis://127.0.0.1:6379

# Authentication & Security
# In production, JWT_SECRET must be at least 32 characters of high-entropy randomness.
JWT_SECRET=replace_with_a_secure_random_string_min_32_characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend Base URL (used for CORS and trusted origin verification in production)
FRONTEND_URL=http://localhost:5173

# Public API Base URL (used for generated cURL snippets and client integration)
PUBLIC_API_URL=http://localhost:5000

# Development & Demo Handlers (echo, fail)
# Set to 'false' in production so demo dispatchers and synthetic failures cannot run.
ENABLE_DEMO_HANDLERS=false

# Global API Rate Limiting (per IP window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# Automated Stuck-Execution Recovery Service
RECOVERY_ENABLED=true
RECOVERY_INTERVAL_MS=60000
RECOVERY_STALE_THRESHOLD_MS=300000
RECOVERY_LOCK_TTL_MS=30000
RECOVERY_BATCH_SIZE=50
