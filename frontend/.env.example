# ==============================================================================
# Runnel Frontend Environment Configuration Contract (frontend/.env.example)
# Note: Vite environment variables are injected at BUILD time into static assets.
# Updating these variables on a static host (e.g. Render) requires triggering
# a new build / deploy.
# ==============================================================================

# API Base URL:
# - Local dev: Leave empty to leverage Vite proxy (targets http://localhost:5000)
# - Single-origin Docker/VPS: Leave empty (reverse-proxied by Nginx on same origin)
# - Remote Free Tier (Render): Set to backend URL (e.g. https://runnel-backend-xxxx.onrender.com)
VITE_API_URL=

# Socket.IO Gateway URL:
# - If omitted, automatically defaults to:
#     * Origin of VITE_API_URL (in remote deployment)
#     * window.location.origin (in production single-origin deployments)
#     * http://localhost:5000 (strictly in DEV mode)
# - Explicit override (optional):
VITE_SOCKET_URL=

# Demo task dispatcher visibility flag (defaults to false in production)
VITE_ENABLE_DEMO_DISPATCHER=false
