{
  "name": "runnel-backend",
  "version": "1.0.0",
  "description": "Backend for Runnel — Recovery Inbox for Asynchronous Work",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "NODE_ENV=test node --test \"tests/auth.test.js\" \"tests/executions/*.test.js\" \"tests/unit/*.test.js\" \"tests/release-gate-verification.js\"",
    "test:auth": "NODE_ENV=test node --test tests/auth.test.js",
    "test:executions": "NODE_ENV=test node --test \"tests/executions/**/*.test.js\" \"tests/unit/**/*.test.js\"",
    "test:gate": "NODE_ENV=test node --test tests/release-gate-verification.js",
    "check": "find . -type f -name '*.js' -not -path './node_modules/*' -print0 | xargs -0 -n1 node --check"
  },
  "keywords": [
    "runnel",
    "recovery-inbox",
    "background-jobs",
    "bullmq",
    "resilience"
  ],
  "author": "Runnel Contributors",
  "license": "MIT",
  "dependencies": {
    "@bull-board/api": "^7.1.5",
    "@bull-board/express": "^7.1.5",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.76.10",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.3.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.0.3",
    "rate-limit-redis": "^5.0.0",
    "socket.io": "^4.8.1",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.10.0",
    "winston-daily-rotate-file": "^4.7.1",
    "xss-clean": "^0.1.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.0.1",
    "supertest": "^7.3.1"
  }
}
