# ==============================================================================
# Runnel Backend Environment Configuration Contract (backend/.env.example)
# Open-source recovery inbox for asynchronous work.
# ==============================================================================

NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/runnel
REDIS_URL=redis://127.0.0.1:6379

# In production, JWT_SECRET must be at least 32 characters of high-entropy randomness.
JWT_SECRET=replace_with_a_secure_random_string_min_32_characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

FRONTEND_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:5000
ENABLE_DEMO_HANDLERS=false

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# Per-User Execution Submission Quota & Concurrency Limits
EXECUTION_RATE_LIMIT_WINDOW_MS=60000
EXECUTION_RATE_LIMIT_MAX=60
MAX_CONCURRENT_EXECUTIONS_PER_USER=25

# Request & Payload Size Bounds
MAX_PAYLOAD_SIZE=2mb

# Hardened Outbound Webhook Dispatcher
WEBHOOK_REQUEST_TIMEOUT_MS=10000
WEBHOOK_CONNECT_TIMEOUT_MS=5000
WEBHOOK_MAX_REDIRECTS=3
WEBHOOK_MAX_RESPONSE_BYTES=1048576

# Automated stuck-execution recovery service
RECOVERY_ENABLED=true
RECOVERY_INTERVAL_MS=60000
RECOVERY_STALE_THRESHOLD_MS=300000
RECOVERY_LOCK_TTL_MS=30000
RECOVERY_BATCH_SIZE=50

